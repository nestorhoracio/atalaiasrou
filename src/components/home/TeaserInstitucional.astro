---
const items = [
	{
		href: '/institucional/',
		titulo: 'Institucional',
		texto: 'Conocé a los pastores mundiales, nacionales y regionales que acompañan esta obra.',
	},
	{
		href: '/uruguay/',
		titulo: 'IMTF Uruguay',
		texto: 'Historia, actividades y noticias del proyecto en Uruguay.',
	},
	{
		href: '/brasil/',
		titulo: 'IMTF Brasil',
		texto: 'História, atividades e notícias do projeto no Brasil.',
	},
];
---

<section class="seccion teaser">
	<div class="contenedor">
		<p class="etiqueta">Nuestros proyectos</p>
		<h2>Predicación y acción social en Uruguay y Brasil</h2>

		<div class="teaser__grid">
			{
				items.map((item) => (
					<a class="teaser__tarjeta tarjeta" href={item.href}>
						<h3>{item.titulo}</h3>
						<p>{item.texto}</p>
						<span class="teaser__flecha" aria-hidden="true">→</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.teaser__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.teaser__tarjeta {
		display: block;
		padding: 1.75rem;
		text-decoration: none;
		color: var(--text);
		position: relative;
	}

	.teaser__tarjeta h3 {
		color: var(--azul);
	}

	.teaser__tarjeta p {
		color: var(--text-muted);
		margin-bottom: 0;
	}

	.teaser__flecha {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		color: var(--dorado);
		font-size: 1.2rem;
	}
</style>
