---
interface Props {
	lang?: 'es' | 'pt';
	videoIds: string[];
}

const { lang = 'es', videoIds } = Astro.props;

const textos = {
	es: { titulo: 'Videos', vacio: 'Todavía no hay videos cargados. Muy pronto vas a poder verlos acá.' },
	pt: { titulo: 'Vídeos', vacio: 'Ainda não há vídeos publicados. Em breve você poderá vê-los aqui.' },
} as const;

const t = textos[lang];
---

<section id="videos" class="seccion contenedor" style="text-align: center;">
	<h2>{t.titulo}</h2>
	{videoIds.length === 0 ? (
		<p style="color: var(--text-soft);">{t.vacio}</p>
	) : (
		<div class="videos-grid">
			{videoIds.map((id) => (
				<div class="videos-grid__item">
					<iframe
						src={`https://www.youtube-nocookie.com/embed/${id}`}
						title="Video"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				</div>
			))}
		</div>
	)}
</section>

<style>
	.videos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.25rem;
	}

	.videos-grid__item {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--surface-2);
	}

	.videos-grid__item iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
