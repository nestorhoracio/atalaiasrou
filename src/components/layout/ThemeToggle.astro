---
---

<button id="atalaias-theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema claro/oscuro">
	<span class="theme-toggle__icon theme-toggle__icon--sol" aria-hidden="true">☀️</span>
	<span class="theme-toggle__icon theme-toggle__icon--luna" aria-hidden="true">🌙</span>
</button>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		cursor: pointer;
		font-size: 1.1rem;
		line-height: 1;
	}

	.theme-toggle__icon--luna {
		display: none;
	}

	:global([data-theme='dark']) .theme-toggle__icon--sol {
		display: none;
	}

	:global([data-theme='dark']) .theme-toggle__icon--luna {
		display: inline;
	}
</style>

<script is:inline>
	(function () {
		const boton = document.getElementById('atalaias-theme-toggle');
		if (!boton) return;

		function temaActual() {
			return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
		}

		boton.addEventListener('click', () => {
			const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', nuevo);
			try {
				localStorage.setItem('atalaias-theme', nuevo);
			} catch {}
		});
	})();
</script>
