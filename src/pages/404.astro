---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout title="Página no encontrada — Atalaias Rou" description="La página que buscás no existe o fue movida.">
	<Header />
	<main class="contenedor seccion" style="text-align:center;">
		<p class="etiqueta">Error 404</p>
		<h1>Esta página no existe</h1>
		<p>Puede que el enlace esté roto o que la página haya cambiado de dirección.</p>
		<a class="boton boton--primario" href="/">Volver al inicio</a>
	</main>
	<Footer />
</Layout>
