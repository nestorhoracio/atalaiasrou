---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SubsiteNav from '../../components/subsite/SubsiteNav.astro';
import DeclaracionFe from '../../components/subsite/DeclaracionFe.astro';
import Galeria from '../../components/subsite/Galeria.astro';
import Videos from '../../components/subsite/Videos.astro';
import Horarios from '../../components/subsite/Horarios.astro';
import NoticiaCard from '../../components/noticias/NoticiaCard.astro';
import { declaracaoDeFe, historia, fotos, videoIdsYoutube } from '../../data/contenido-brasil';
import { horarios as horariosBrasil } from '../../data/horarios-brasil';

const horarios = horariosBrasil.map((h) => ({ actividad: h.atividade, dia: h.dia, hora: h.hora }));

const ultimasNoticias = (await getCollection('noticias-brasil', ({ data }) => !data.borrador && data.fecha <= new Date()))
	.sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
	.slice(0, 3);
---

<Layout
	title="IMTF Brasil — Atalaias Rou"
	description="Declaração de fé, história, atividades e notícias do IMTF Brasil: pregação do evangelho e ação social."
	lang="pt"
	organizacion={{
		nombre: 'IMTF Brasil',
		descripcion: 'Projeto de pregação do evangelho e ação social no Brasil.',
		areaServida: 'Brasil',
		padre: true,
	}}
>
	<Header lang="pt" />
	<SubsiteNav lang="pt" base="/brasil" activo="inicio" />

	<header class="seccion contenedor" style="text-align: center;">
		<p class="etiqueta">IMTF Brasil</p>
		<h1>Pregação do evangelho e ação social</h1>
	</header>

	<DeclaracionFe lang="pt" declaracion={declaracaoDeFe} historia={historia} />
	<Galeria lang="pt" fotos={fotos} />
	<Videos lang="pt" videoIds={videoIdsYoutube} />
	<Horarios lang="pt" items={horarios} />

	<section class="seccion contenedor" style="text-align: center;">
		<h2>Últimas notícias</h2>
		{ultimasNoticias.length === 0 ? (
			<p style="color: var(--text-soft);">Ainda não há notícias publicadas.</p>
		) : (
			<div class="grid-auto">
				{ultimasNoticias.map((noticia) => (
					<NoticiaCard
						href={`/brasil/noticias/${noticia.id}/`}
						titulo={noticia.data.titulo}
						resumen={noticia.data.resumen}
						fecha={noticia.data.fecha}
						imagen={noticia.data.imagen}
						imagenAlt={noticia.data.imagenAlt}
						lang="pt"
					/>
				))}
			</div>
		)}
		<p style="margin-top: 1.5rem;"><a href="/brasil/noticias/">Ver todas as notícias →</a></p>
	</section>

	<Footer lang="pt" />
</Layout>
