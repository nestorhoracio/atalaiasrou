---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import SubsiteNav from '../../../components/subsite/SubsiteNav.astro';
import NoticiaCard from '../../../components/noticias/NoticiaCard.astro';
import { breadcrumbList } from '../../../lib/seo';

const noticias = (await getCollection('noticias-uruguay', ({ data }) => !data.borrador && data.fecha <= new Date())).sort(
	(a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<Layout
	title="Noticias — IMTF Uruguay"
	description="Novedades y noticias del proyecto IMTF Uruguay."
	lang="es"
	extraJsonLd={[
		breadcrumbList(Astro.site!, [
			{ name: 'Inicio', path: '/' },
			{ name: 'IMTF Uruguay', path: '/uruguay/' },
			{ name: 'Noticias', path: '/uruguay/noticias/' },
		]),
	]}
>
	<Header />
	<SubsiteNav lang="es" base="/uruguay" activo="noticias" />

	<section class="seccion contenedor" style="text-align: center;">
		<p class="etiqueta">IMTF Uruguay</p>
		<h1>Noticias</h1>

		{noticias.length === 0 ? (
			<p style="color: var(--text-soft);">Todavía no hay noticias publicadas.</p>
		) : (
			<div class="grid-auto">
				{noticias.map((noticia) => (
					<NoticiaCard
						href={`/uruguay/noticias/${noticia.id}/`}
						titulo={noticia.data.titulo}
						resumen={noticia.data.resumen}
						fecha={noticia.data.fecha}
						imagen={noticia.data.imagen}
						imagenAlt={noticia.data.imagenAlt}
						lang="es"
					/>
				))}
			</div>
		)}
	</section>

	<Footer lang="es" />
</Layout>
