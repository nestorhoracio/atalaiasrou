---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PastoresGrid from '../components/institucional/PastoresGrid.astro';
---

<Layout
	title="Institucional — Atalaias Rou"
	description="Conocé a los pastores mundiales, nacionales y regionales que acompañan el ministerio de Atalaias Rou / IMTF Uruguay y Brasil."
	organizacion={{
		nombre: 'Atalaias Rou / IMTF Uruguay y Brasil',
		padre: true,
	}}
>
	<Header />

	<header class="seccion contenedor">
		<p class="etiqueta">Institucional</p>
		<h1>Liderazgo del ministerio</h1>
		<p style="color: var(--text-muted); max-width: 60ch;">
			Presentamos a los pastores mundiales, nacionales y regionales que guían la predicación del evangelio y la obra
			social de Atalaias Rou.
		</p>
	</header>

	<section class="seccion contenedor" style="padding-top: 0;">
		<PastoresGrid />
	</section>

	<Footer />
</Layout>
